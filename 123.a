#include <stdio.h>
int main()
{
 int n;
 printf("How many elements you want: ");
 scanf("%d",&n);
 int a[n],i;
 printf("Enter %d element: ", n);
 for(i=0;i<n;i++)
 {
     scanf("%d",&a[i]);
 }
 printf("Your element are: ");
 for(i=0;i<n;i++)
 {
     printf("%d, ",a[i]);
 }
 return 0;
}
